<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds must register with the PRODUCTION APNs
	     environment or FCM push will not reach App Store / TestFlight
	     users. Debug/Profile keep Runner.entitlements (development). -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
